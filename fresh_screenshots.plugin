__id__ = "fresh_screenshots"
__name__ = "Fresh Screenshots"
__description__ = "Photos and screenshots you just took show up in the attach sheet at once, first in line with their thumbnail, instead of seconds later. Also stops XF rescanning your whole gallery every time you come back to the app. Made by [firestarter1996](https://github.com/firestarter1996)."
__author__ = "firestarter1996"
__version__ = "1.0.0"
__min_version__ = "12.5.1"

# Stock XF only learns about a new photo through a full rescan of the whole gallery: its MediaStore
# observer waits 2 s after the LAST change (each write of a screenshot restarts the wait), then a
# minimum priority thread reads every image and video row and sorts every album. With tens of
# thousands of photos that takes seconds. checkGallery() on every app resume also compares the photo
# count with photos plus videos, which never match when any video exists, so it rescans every time.
# The Java part (embedded below) adds a fast path: its own MediaStore observer that reads only the
# newest rows 120 ms after a change and swaps in copies of the albums with the new photos at the top,
# the same way stock publishes a rescan; the same check runs when the attach sheet opens, and on
# resume the full rescan only runs when the photo count really changed. No polling, the work runs on
# its own background thread, the UI thread only swaps the lists. Logcat tag XFFresh (errors only).

import base64
import zlib

from java import jclass
from base_plugin import BasePlugin
from ui.settings import Header, Text

ENTRY = "com.firestarter.xffresh.FreshShots"


def _log(msg):
    try:
        jclass("android.util.Log").i("XFFresh", str(msg))
    except Exception:
        pass


class FreshScreenshotsPlugin(BasePlugin):

    def create_settings(self):
        st = "not running"
        try:
            if self.core is not None:
                st = str(self.core.getMethod("stats").invoke(None))
        except Exception:
            pass
        return [Header(text="Fresh Screenshots"), Text(text="Status", subtext=st)]

    def on_plugin_load(self):
        self.core = None
        try:
            ctx = jclass("org.telegram.messenger.ApplicationLoader").applicationContext
            with open(__file__, "r", encoding="utf-8") as fh:
                text = fh.read()
            block = text.rsplit("# __DEX_BEGIN__", 1)[1].split("# __DEX_END__", 1)[0]
            payload = "".join(l.strip()[1:].strip() for l in block.splitlines() if l.strip().startswith("#"))
            data = zlib.decompress(base64.b64decode(payload))
            Loader = jclass("dalvik.system.InMemoryDexClassLoader")
            self.loader = Loader(jclass("java.nio.ByteBuffer").wrap(data), ctx.getClassLoader())
            self.core = self.loader.loadClass(ENTRY)
            AU = jclass("org.telegram.messenger.AndroidUtilities")
            from android_utils import R
            self._r = R(lambda: _log("install %s: %s" % (__version__, self.core.getMethod("install", jclass("java.lang.ClassLoader"), jclass("android.content.Context")).invoke(None, ctx.getClassLoader(), ctx))))
            AU.runOnUIThread(self._r)
        except Exception as e:
            self.core = None
            _log("load: %s" % e)

    def on_plugin_unload(self):
        try:
            if self.core is not None:
                self.core.getMethod("uninstall").invoke(None)
                _log("uninstalled")
        except Exception as e:
            _log("unload: %s" % e)
        self.core = None

